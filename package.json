{
  "name": "qfb",
  "version": "0.1.0",
  "description": "QuestDB Feature Builder (QFB) — a durable Pi/Herdr development orchestrator",
  "type": "module",
  "bin": {
    "qfb": "src/index.ts"
  },
  "scripts": {
    "qfb": "node --experimental-strip-types --no-warnings src/index.ts",
    "start": "node --experimental-strip-types --no-warnings src/index.ts",
    "test": "node --test --experimental-strip-types --no-warnings 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0"
  }
}
